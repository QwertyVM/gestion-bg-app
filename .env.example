# URL de conexión a la base de datos PostgreSQL (Neon, Supabase o local)
# Ejemplo Neon: postgresql://neondb_owner:xxxxxx@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Ejemplo Supabase: postgresql://postgres:xxxxxx@db.xyz.supabase.co:5432/postgres
# Ejemplo Local: postgresql://postgres:postgres@localhost:5432/gestion3d
DATABASE_URL="postgresql://usuario:password@localhost:5432/gestion_3d?schema=public"
